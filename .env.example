# Copy to .env and replace each hash. One entry per app. Do not commit .env.
# python -c "import hashlib,secrets; s=secrets.token_urlsafe(32); print(s); print(hashlib.sha256(s.encode()).hexdigest())"
WHISPER_KEYS=app-a:replace-with-64-hex,app-b:replace-with-64-hex
WHISPER_MODEL=small
WHISPER_PORT=8080
